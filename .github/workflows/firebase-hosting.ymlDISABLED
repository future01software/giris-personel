name: Deploy Frontend to Firebase Hosting

on:
  push:
    branches: [ "main" ]
    paths:
      - "frontend/**"
  workflow_dispatch:
jobs:
  build_and_deploy:
    runs-on: ubuntu-latest
    steps:
      - uses: actions/checkout@v4

      - name: Use Node.js
        uses: actions/setup-node@v4
        with:
          node-version: 20

      - name: Install & Build
        working-directory: frontend
        run: |
          npm install
          echo "REACT_APP_BACKEND_URL=https://clear2work-backend-502514677126.europe-west1.run.app" > .env
          npm run build

      - name: Deploy to Firebase Hosting
        uses: FirebaseExtended/action-hosting-deploy@v0
        with:
          repoToken: "${{ secrets.GITHUB_TOKEN }}"
          firebaseServiceAccount: "${{ secrets.FIREBASE_SERVICE_ACCOUNT_ELOQUENT_MARKER_484206_F5 }}"
          projectId: eloquent-marker-484206-f5
          entryPoint: frontend
          channelId: live
